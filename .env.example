# Non-secret settings: copy to .env. Keys and secrets go in .env.secrets (see .env.secrets.example).
# Copy to .env and fill in. Never commit .env. The browser never sees anything in this file
# except NEXT_PUBLIC_API_URL.

# ---- App ----
APP_ENV=local                      # local | production
API_HOST=127.0.0.1                 # keep 127.0.0.1: the app is not exposed to your network
API_PORT=8000
WEB_PORT=3000
WEB_ORIGIN=http://localhost:3000   # CORS: only this origin may call the API
NEXT_PUBLIC_API_URL=http://localhost:8000
DATABASE_URL=sqlite:///./data/app.db   # relative to services/api. Postgres: postgresql+psycopg://user:pass@host/db

# ---- Token encryption (required before connecting Instagram) ----
# Generate: services/api/.venv/bin/python scripts/gen_key.py
# Rotation: put the NEW key first, old key second, comma-separated, then run `make rotate-keys`.

# ---- Agents ----
AGENT_MODE=mock                    # mock | bedrock | openai | anthropic | agentcore
# OPENAI_MODEL_ID=                 # e.g. a model name from platform.openai.com
# ANTHROPIC_MODEL_ID=claude-sonnet-5-5
AWS_REGION=us-east-1
# AWS_PROFILE=default              # uses your local AWS CLI profile; no keys in this file
# BEDROCK_MODEL_ID=                # a model or inference profile ID enabled in your account+region
BEDROCK_MAX_TOKENS=2000
AGENT_TIMEOUT_SECONDS=90
AGENT_MAX_CONCURRENCY=2
AGENT_MAX_MODEL_CALLS=8
# AGENTCORE_RUNTIME_ARN=           # Mode C only, after you deploy

# ---- Meta: Instagram API with Instagram Login ----
META_REDIRECT_URI=http://localhost:8000/api/instagram/callback
INSTAGRAM_API_VERSION=v23.0

# ---- Optional ----
# S3_MEDIA_BUCKET=                 # public-read bucket/prefix for videos Meta must fetch when publishing
# RESEARCH_API_URL=                # Tavily-compatible search endpoint for the research agent
# RESEARCH_API_KEY=
ENABLE_LOCAL_SCHEDULER=false       # true = reminders + read-only daily Instagram sync at 06:30 IST (never publishes)
