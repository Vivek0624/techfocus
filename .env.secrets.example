# Copy to .env.secrets and fill in. Never commit .env.secrets.

# Encrypts the Instagram token stored in the local database. Generate: make key
TOKEN_ENCRYPTION_KEY=

# Meta app (Instagram API with Instagram Login): Instagram app ID and secret
META_APP_ID=
META_APP_SECRET=

# AI model keys (only the one for your AGENT_MODE is needed).
# Free Gemini key: aistudio.google.com -> Get API key. It goes in OPENAI_API_KEY (Gemini's OpenAI-compatible API).
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# AWS (only for AGENT_MODE=bedrock or agentcore)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# Optional: protects the local API with a bearer token
API_AUTH_TOKEN=
